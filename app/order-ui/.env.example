VERSION=v1.0.0
# terminal (nghiệp vụ cửa hàng: đơn, ca làm, VAT, RFID, role/branch) — cổng 8088
VITE_BASE_API_URL="http://localhost:8088/api/${VERSION}"
# shared-user (identity service: đăng nhập, đăng ký, quên/đổi mật khẩu, hồ sơ
# cá nhân, avatar, xoá tài khoản, refresh token) — cổng 8086.
#
# ⚠️ BẮT BUỘC. Thiếu biến này thì `httpAuth` không có baseURL, request rơi vào
# cùng origin, và lỗi chỉ hiện ra ở tận màn đăng nhập.
VITE_AUTH_API_URL="http://localhost:8086/api/${VERSION}"
VITE_ORDER_EXPIRATION_TIME_SECONDS=900
